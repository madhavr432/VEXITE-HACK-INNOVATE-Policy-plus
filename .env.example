# Policy+ Environment Configuration (Example)
# DO NOT commit real secrets to version control.
# Copy this file to .env and fill in real values.

# Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=https://policy-plus-zeta.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Gemini AI Policy Analyst (Backend only)
# Obtain your API key from: https://aistudio.google.com/apikey
# Both variable names are supported (GEMINI_API_KEY takes priority)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Frontend Configuration
VITE_API_URL=https://vexite-hack-innovate-policy-plus-3.onrender.com
# For local development in .env.local:
# VITE_API_URL=http://localhost:8000

# IMPORTANT: Never add GEMINI_API_KEY or GOOGLE_API_KEY to VITE_* variables.
# Gemini requests must always go through the FastAPI backend.

